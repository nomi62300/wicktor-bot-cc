# Copy this file to .env for local development. NEVER commit .env.
# All values below are placeholders — replace with real values locally
# or, in production, set these directly as Render environment variables.

# Bybit Demo Trading API credentials (generated from the Demo Trading
# account view, NOT the regular mainnet API key page).
BYBIT_DEMO_API_KEY=your_key_here
BYBIT_DEMO_API_SECRET=your_secret_here

# Virtual bankroll this bot sizes all trades against — independent of
# Bybit's real demo-account equity (which auto-initializes at 50,000 USDT).
INTENDED_ACCOUNT_SIZE_USDT=100

# HTTP port for the Express server / dashboard.
PORT=3000

# SQLite database file path. On Render this MUST point inside a mounted
# persistent Disk (e.g. /var/data/wicktor.db) or trade history is wiped
# on every deploy/restart.
DB_PATH=./data/wicktor.db

# Risk management
RISK_PCT=0.0015
LEVERAGE=5
MAX_POSITIONS=3
# Minimum stop distance, expressed as a multiple of ATR — stops are never
# tighter than this, regardless of the fractal/jaw distance found.
STOP_ATR_FLOOR_MULT=1.0

# Optional safety cap on position notional value, as a fraction of bankroll
# (e.g. 0.5 = never open a position worth more than 50% of bankroll,
# regardless of computed risk-based qty). Unset/blank = no cap. If set and
# triggered, the trade is explicitly SKIPPED and logged — never silently
# resized under the same "flat risk %" label (see brief section 5e).
MAX_NOTIONAL_PCT_OF_BANKROLL=

# Universe filter
MIN_TURNOVER_24H_USDT=15000000

# Loop cadence (ms)
POSITION_MONITOR_INTERVAL_MS=30000
ENTRY_SCAN_INTERVAL_MS=60000

# Optional shared-secret required (as an x-admin-token header) to call
# state-changing dashboard endpoints (currently: manually closing a
# position). Unset = those endpoints are unprotected — fine for local
# dev, set this for any public deploy.
ADMIN_TOKEN=
